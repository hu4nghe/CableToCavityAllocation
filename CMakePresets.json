{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 28
    },
    "configurePresets": [
        {
            "name": "default-windows",
            "description": "Windows - clang + Ninja",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "Python3_EXECUTABLE": "${sourceDir}/Python/venv/Scripts/python.exe"
            },
            "environment": {
                "PATH": "${sourceDir}/Python/DSLyon/Scripts;$penv{PATH}"
            }
        },
        {
            "name": "default-linux",
            "description": "Linux - GCC + Make",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        }
    ]
}
